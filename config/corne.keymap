/*
 * Copyright (c) 2020 The ZMK Contributors
 * SPDX-License-Identifier: MIT
 *
 * Corne 42 / macOS / ABC + Russian (Apple, NOT Russian-PC).
 * Local candidate; not a compiled or hardware-tested firmware.
 * Based on silkdemon/keyboard d2cdf2ce8778fa5a8c1639bbbdde3530fe4473f8.
 * Symbol legends below assume ABC/US unless explicitly marked Russian.
 */
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

#define BASE 0
#define NAV 1
#define SYM 2
#define SYS 3

/* Apple Russian: BSLH = ё, Shift+6 = comma, Shift+7 = period.
 * These are host-layout-dependent keycodes, not Unicode output.
 */
#define RU_YO BSLH
#define RU_COMMA LS(N6)
#define RU_DOT LS(N7)

&lt {
    flavor = "balanced";
    tapping-term-ms = <200>;
    quick-tap-ms = <150>;
};

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";
        system_layer {
            if-layers = <NAV SYM>;
            then-layer = <SYS>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            // ESC  Й Ц У К Е | Н Г Ш Щ З Ё
            // TAB  Ф Ы В А П | Р О Л Д Ж Э
            // CTRL Я Ч С М И | Т Ь Б Ю Х Ъ
            //      SHIFT SPACE CMD | NAV BACKSPACE ENTER/SYM
            bindings = <
&kp ESC   &kp Q &kp W &kp E &kp R &kp T     &kp Y &kp U &kp I     &kp O   &kp P    &kp RU_YO
&kp TAB   &kp A &kp S &kp D &kp F &kp G     &kp H &kp J &kp K     &kp L   &kp SEMI &kp SQT
&kp LCTRL &kp Z &kp X &kp C &kp V &kp B     &kp N &kp M &kp COMMA &kp DOT &kp LBKT &kp RBKT
                      &kp LSHFT &kp SPACE &kp LGUI     &mo NAV &kp BSPC &lt SYM RET
            >;
        };

        nav_layer {
            // Ctrl+Space assumes the standard macOS input-source shortcut.
            // Word/start/end movement uses macOS Option/Command + arrows.
            // Bottom-left punctuation is specifically for Apple Russian.
            bindings = <
&kp LC(SPACE) &kp LG(A) &kp LG(S) &kp LG(F) &kp LG(Z) &kp LG(LS(Z))   &kp LA(LEFT) &kp LG(LEFT) &kp UP   &kp LG(RIGHT) &kp LA(RIGHT) &kp DEL
&kp LALT      &kp LG(X) &kp LG(C) &kp LG(V) &kp LG(T) &kp LG(W)       &kp HOME     &kp LEFT     &kp DOWN &kp RIGHT     &kp END       &kp BSPC
&trans        &kp ESC   &kp TAB   &kp RU_COMMA &kp RU_DOT &none       &kp PG_UP    &kp PG_DN    &none    &none         &none         &none
                                  &trans &trans &trans              &trans &trans &trans
            >;
        };

        symbols_layer {
            // English/ABC legends. Russian punctuation: NAV+C / NAV+V.
            // Upper row numbers also provide Russian shifted punctuation.
            bindings = <
&kp ESC   &kp N1    &kp N2    &kp N3    &kp N4    &kp N5       &kp N6    &kp N7   &kp N8   &kp N9   &kp N0   &kp GRAVE
&kp TAB   &kp EXCL  &kp AT    &kp HASH  &kp DLLR  &kp PRCNT    &kp CARET &kp AMPS &kp STAR &kp LPAR &kp RPAR &kp BSLH
&kp LCTRL &kp GRAVE &kp TILDE &kp MINUS &kp UNDER &kp PLUS     &kp EQUAL &kp LBKT &kp RBKT &kp LBRC &kp RBRC &kp FSLH
                             &trans &trans &trans            &trans &trans &trans
            >;
        };

        system_layer {
            // Hold NAV and ENTER/SYM together. Thumbs remain transparent.
            // BT_CLR clears ONLY the selected host profile; no BT_CLR_ALL.
            bindings = <
&kp F1 &kp F2 &kp F3 &kp F4 &kp F5 &kp F6                       &kp F7 &kp F8 &kp F9 &kp F10 &kp F11 &kp F12
&none &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4  &out OUT_USB &out OUT_BLE &kp C_MUTE &kp C_VOL_DN &kp C_VOL_UP &none
&trans &none &none &none &none &none                            &kp C_PREV &kp C_PP &kp C_NEXT &none &none &bt BT_CLR
                       &trans &trans &trans                    &trans &trans &trans
            >;
        };
    };
};
